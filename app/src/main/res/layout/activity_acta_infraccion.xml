<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:nestedScrollingEnabled="false"
    android:fillViewport="true"
    android:background="#F3F4F6"
    tools:context=".ActaInfraccionActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- 🔹 Encabezado institucional -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#3EBD84"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:elevation="2dp">

            <!-- Botón X para cancelar -->
            <ImageButton
                android:id="@+id/btnCancelHeader"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                android:tint="#FFFFFF"
                android:contentDescription="Cancelar" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_toStartOf="@id/btnCancelHeader"
                android:layout_marginEnd="8dp"
                android:orientation="vertical">

            <TextView
                android:id="@+id/tvHeaderMunicipio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MUNICIPALIDAD DE POSADAS"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:letterSpacing="0.05" />

            <TextView
                android:id="@+id/tvHeaderReparticion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dirección de Obras Privadas"
                android:textColor="#E9FFFA"
                android:textSize="13sp"
                android:layout_marginTop="2dp" />
            </LinearLayout>
        </RelativeLayout>

        <!-- 🔹 Card principal del formulario -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="16dp"
            android:layout_marginTop="12dp"
            android:elevation="2dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ACTA DE INFRACCIÓN / INSPECCIÓN"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#222222"
                android:gravity="center"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Complete los datos del propietario, inmueble y seleccione las causas o resultados según corresponda."
                android:textSize="12sp"
                android:textColor="#777777"
                android:gravity="center"
                android:layout_marginBottom="16dp" />

            <!-- DATOS DEL PROPIETARIO -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="DATOS DEL PROPIETARIO"
                android:textStyle="bold"
                android:textColor="#3EBD84"
                android:textSize="14sp" />

            <View
                android:layout_width="36dp"
                android:layout_height="2dp"
                android:background="#3EBD84"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="6dp" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilPropietario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp">

                <EditText
                    android:id="@+id/etPropietario"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Nombre y Apellido *"
                    android:inputType="textCapWords" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilDomicilio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">

                <EditText
                    android:id="@+id/etDomicilio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Domicilio *"
                    android:inputType="textCapWords" />
            </com.google.android.material.textfield.TextInputLayout>

            <CheckBox
                android:id="@+id/cbMismoLugar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="El lugar de la infracción es el mismo que el domicilio"
                android:checked="true"
                android:textColor="#555555"
                android:layout_marginTop="4dp" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilLugarInfraccion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">

                <EditText
                    android:id="@+id/etLugarInfraccion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Lugar de Infracción *"
                    android:inputType="textCapWords" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- DATOS DEL INMUEBLE -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="DATOS DEL INMUEBLE"
                android:textStyle="bold"
                android:textColor="#3EBD84"
                android:textSize="14sp"
                android:layout_marginTop="16dp" />

            <View
                android:layout_width="36dp"
                android:layout_height="2dp"
                android:background="#3EBD84"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="6dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp">

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp">

                    <EditText
                        android:id="@+id/etSeccion"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Sección" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp">

                    <EditText
                        android:id="@+id/etChacra"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Chacra" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp">

                    <EditText
                        android:id="@+id/etManzana"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Manzana" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp">

                    <EditText
                        android:id="@+id/etParcela"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Parcela" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp">

                    <EditText
                        android:id="@+id/etLote"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Lote" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp">

                    <EditText
                        android:id="@+id/etPartida"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Partida" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <!-- Error Label for Selection -->
            <TextView
                android:id="@+id/tvErrorSelection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Debe seleccionar al menos una opción"
                android:textColor="#B00020"
                android:textSize="12sp"
                android:gravity="start"
                android:layout_marginStart="4dp"
                android:layout_marginTop="8dp"
                android:visibility="gone"
                tools:visibility="visible" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp">

                <Button
                    android:id="@+id/btnModeInfraccion"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="ACTA DE\nINFRACCIÓN"
                    android:textSize="12sp"
                    android:backgroundTint="#3EBD84"
                    android:textColor="#FFFFFF"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/btnModeInspeccion"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="ACTA DE\nINSPECCIÓN"
                    android:textSize="12sp"
                    android:backgroundTint="#E0E0E0"
                    android:textColor="#757575"
                    android:layout_marginStart="4dp" />
            </LinearLayout>

            <!-- CONTAINER INFRACCIÓN -->
            <LinearLayout
                android:id="@+id/layoutContainerInfraccion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="visible">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="CAUSAS / FALTAS (INFRACCIÓN)"
                    android:textStyle="bold"
                    android:textColor="#3EBD84"
                    android:textSize="14sp"
                    android:layout_marginTop="8dp" />

                <View
                    android:layout_width="36dp"
                    android:layout_height="2dp"
                    android:background="#3EBD84"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="6dp" />

                <!-- Botón + resumen (RESTORED) -->
                <Button
                    android:id="@+id/btnSeleccionarCausas"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Seleccionar causas / faltas"
                    android:layout_marginTop="4dp"
                    android:backgroundTint="#E6F7F0"
                    android:textColor="#1A7A50"
                    android:textAllCaps="false" />

                <!-- Resumen + Botón de borrar -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="4dp">
                    
                    <TextView
                        android:id="@+id/tvCausasSeleccionadas"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Ninguna causa seleccionada"
                        android:textSize="13sp"
                        android:textColor="#555555"
                        android:lineSpacingExtra="4dp" />
                        
                    <TextView
                        android:id="@+id/btnLimpiarInfraccion"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Limpiar lista"
                        android:textColor="#B00020"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:layout_gravity="end"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:paddingStart="12dp"
                        android:paddingEnd="4dp"
                        android:background="?attr/selectableItemBackground"
                        android:visibility="gone"
                        tools:visibility="visible" />
                </LinearLayout>

                <!-- CheckBoxes (HIDDEN AGAIN) -->
                <LinearLayout
                    android:id="@+id/layoutCausasCheckBoxes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <CheckBox
                        android:id="@+id/cbNumeroPermiso"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:padding="8dp"
                        android:textSize="16sp"
                        android:text="Nº Permiso (punto 2.2.6 y anexos C.E.P.)" />
                    
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#F0F0F0"/>

                    <CheckBox
                        android:id="@+id/cbIncumplimiento"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:padding="8dp"
                        android:textSize="16sp"
                        android:text="Incumplimiento" />

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#F0F0F0"/>

                    <CheckBox
                        android:id="@+id/cbCartelObra"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:padding="8dp"
                        android:textSize="16sp"
                        android:text="Cartel de Obra Reglamentario (punto 2.2.12 C.E.P.)" />

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#F0F0F0"/>

                    <CheckBox
                        android:id="@+id/cbDispositivosSeguridad"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:padding="8dp"
                        android:textSize="16sp"
                        android:text="Dispositivos de Seguridad (punto 4.14 y anexos C.E.P.)" />

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#F0F0F0"/>

                    <CheckBox
                        android:id="@+id/cbMaterialesVereda"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:padding="8dp"
                        android:textSize="16sp"
                        android:text="Materiales en Vereda (punto 3.5.2.4 C.E.P.)" />

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#F0F0F0"/>

                    <CheckBox
                        android:id="@+id/cbCercoObra"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:padding="8dp"
                        android:textSize="16sp"
                        android:text="Cerco de Obra (punto 4.1 y anexos C.E.P.)" />

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#F0F0F0"/>

                    <CheckBox
                        android:id="@+id/cbPlanosAprobados"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:padding="8dp"
                        android:textSize="16sp"
                        android:text="Planos Aprobados (punto 2.1.8.7 C.E.P.)" />

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#F0F0F0"/>

                    <CheckBox
                        android:id="@+id/cbDirectorObra"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:padding="8dp"
                        android:textSize="16sp"
                        android:text="Director de Obra (punto 2.4.1 C.E.P.)" />

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#F0F0F0"/>

                    <CheckBox
                        android:id="@+id/cbClausuraPreventiva"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:padding="8dp"
                        android:textSize="16sp"
                        android:text="Clausura preventiva" />

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#F0F0F0"/>

                    <CheckBox
                        android:id="@+id/cbVarios"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:padding="8dp"
                        android:textSize="16sp"
                        android:text="Varios" />

                </LinearLayout>
            </LinearLayout>


            <!-- CONTAINER INSPECCIÓN -->
            <LinearLayout
                android:id="@+id/layoutContainerInspeccion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="RESULTADO (INSPECCIÓN)"
                    android:textStyle="bold"
                    android:textColor="#3EBD84"
                    android:textSize="14sp"
                    android:layout_marginTop="8dp" />

                <View
                    android:layout_width="36dp"
                    android:layout_height="2dp"
                    android:background="#3EBD84"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="6dp" />

                <Button
                    android:id="@+id/btnSeleccionarCausasInspeccion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Seleccionar resultado de inspección"
                    android:layout_marginTop="4dp"
                    android:backgroundTint="#E6F7F0"
                    android:textColor="#1A7A50"
                    android:textAllCaps="false" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="4dp">

                    <TextView
                        android:id="@+id/tvCausasSeleccionadasInspeccion"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Ningún resultado seleccionado"
                        android:textSize="13sp"
                        android:textColor="#555555"
                        android:lineSpacingExtra="4dp" />

                    <TextView
                        android:id="@+id/btnLimpiarInspeccion"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Limpiar lista"
                        android:textColor="#B00020"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:layout_gravity="end"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:paddingStart="12dp"
                        android:paddingEnd="4dp"
                        android:background="?attr/selectableItemBackground"
                        android:visibility="gone"
                        tools:visibility="visible" />
                </LinearLayout>
            </LinearLayout>

            <!-- INFO ADICIONAL -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">

                <EditText
                    android:id="@+id/etBoletaInspeccion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Boleta de Inspección Nº" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">

                <EditText
                    android:id="@+id/etObservaciones"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Observaciones"
                    android:inputType="textMultiLine"
                    android:minLines="3"
                    android:gravity="top|start" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- FIRMA E IMÁGENES -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Firma del Infractor"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Toque para firmar"
                        android:textStyle="italic"
                        android:textSize="12sp"
                        android:textColor="#0066CC" />
                </LinearLayout>

                <es.rcti.demoprinterplus.sistemainmobilario.SignatureView
                    android:id="@+id/signatureView"
                    android:layout_width="match_parent"
                    android:layout_height="150dp"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/btnFirma"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Firmar en pantalla completa"
                    android:layout_marginTop="8dp"
                    android:backgroundTint="#3EBD84"
                    android:textColor="#FFFFFF"
                    android:textAllCaps="false" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp">

                    <Button
                        android:id="@+id/btnExpandSignature"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Expandir firma"
                        android:layout_marginEnd="4dp"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

                    <Button
                        android:id="@+id/btnClearSignature"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Borrar firma"
                        android:layout_marginStart="4dp"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Imágenes de prueba"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginTop="16dp" />

                <Button
                    android:id="@+id/btnAddImages"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Agregar imágenes"
                    android:layout_marginTop="8dp"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvImages"
                    android:layout_width="match_parent"
                    android:layout_height="150dp"
                    android:layout_marginTop="8dp" />
            </LinearLayout>

            <!-- BOTÓN PRINCIPAL -->
            <Button
                android:id="@+id/btnGuardarImprimir"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Guardar e imprimir"
                android:layout_marginTop="16dp"
                android:backgroundTint="#3EBD84"
                android:textColor="#FFFFFF"
                android:textAllCaps="false"
                android:textSize="15sp"
                app:cornerRadius="20dp" />

            <!-- BOTÓN CANCELAR -->
            <Button
                android:id="@+id/btnCancelar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Cancelar"
                android:layout_marginTop="8dp"
                android:backgroundTint="#E53E3E"
                android:textColor="#FFFFFF"
                android:textAllCaps="false"
                android:textSize="14sp"
                app:cornerRadius="20dp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton" />



        </LinearLayout>

    </LinearLayout>
</ScrollView>
